{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@airlock/shared": [
        "../shared/src/index.ts"
      ]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "src",
    "test",
    "entrypoints",
    "e2e",
    "wxt.config.ts",
    ".wxt/wxt.d.ts"
  ]
}
